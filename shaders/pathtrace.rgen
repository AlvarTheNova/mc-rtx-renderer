#version 460
#include "common.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT TLAS;

// G-buffer storage images (see PathTracer::GBuffer)
layout(set = 0, binding = 1, rgba16f) uniform image2D outColor;
layout(set = 0, binding = 10, rgba8) uniform image2D outAlbedo;
layout(set = 0, binding = 11, rgb10_a2) uniform image2D outNormalWs;
layout(set = 0, binding = 12, rg8) uniform image2D outRoughMet;
layout(set = 0, binding = 13, r16f) uniform image2D outSpecHit;
layout(set = 0, binding = 14, rg16f) uniform image2D outMotion;

layout(location = 0) rayPayloadEXT RayPayload pl;

void main() {
    ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
    vec2  res = vec2(U.internal_resolution);

    // Jittered NDC for DLSS-RR input. Jitter is in pixels.
    vec2 uv = (vec2(pix) + 0.5 + U.jitter_pixels) / res;
    vec2 ndc = uv * 2.0 - 1.0;

    // Reconstruct world-space ray from inverse view-proj
    vec4 target  = U.proj_inv * vec4(ndc, 1.0, 1.0);
    vec3 dir_vs  = normalize(target.xyz / target.w);
    vec3 dir_ws  = normalize((U.view_inv * vec4(dir_vs, 0.0)).xyz);
    vec3 orig_ws = U.cam_pos_ws.xyz;

    pl.radiance   = vec3(0.0);
    pl.throughput = vec3(1.0);
    pl.depth      = 0u;
    pl.seed       = pcg_hash(pix.x * 1973u + pix.y * 9277u + U.frame_index * 26699u);

    traceRayEXT(TLAS,
                gl_RayFlagsOpaqueEXT,
                0xFFu,           // cullMask
                0u, 0u, 0u,      // sbtOffset, sbtStride, missIndex
                orig_ws,
                0.001,
                dir_ws,
                10000.0,
                0);

    imageStore(outColor, pix, vec4(pl.radiance, 1.0));
    // TODO: write albedo/normal/rough-met/spec-hit-dist/MV from first-hit
    //       cached values. These are required inputs for DLSS-RR — without
    //       them RR degrades to a basic temporal upscaler.
}
